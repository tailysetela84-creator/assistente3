# Configurações do LLM
# Copie este arquivo para .env e preencha com suas credenciais

# Tipo de LLM: "groq" (API gratuita) ou "ollama" (local)
LLM_TYPE=groq

# API Key do Groq (obter em https://console.groq.com)
GROQ_API_KEY=sua_api_key_aqui

# Modelo Whisper (opcional, usa "tiny" por padrão)
WHISPER_MODEL=tiny